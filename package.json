{
  "name": "ts-cpu",
  "version": "1.0.0",
  "description": "A simple CPU written in Typescript",
  "license": "ISC",
  "author": "king525dev",
  "type": "module",
  "main": "./dist/web/mycpu.iife.js",
  "module": "./dist/web/mycpu.esm.js",
  "exports": {
    ".": {
      "import": "./dist/web/mycpu.esm.js",
      "require": "./dist/web/mycpu.iife.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "manifest": "node scripts/build-program-manifest.mjs",
    "sea:bundle": "node scripts/build-sea.mjs",
    "prebuild": "npm run manifest",
    "build": "vite build",
    "test": "vitest"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
