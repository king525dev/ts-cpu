// Prints an Isosceles Triangle of asterisks //
VAR row
VAR col

LDA 1
STA row

>outer
  LDA 1
  STA col

  >inner
    LDR col
    LDR row
    GTH
    JCN inner_done

    LDA 42
    DCD

    LDR col
    INC
    STA col
    JMP inner

  >inner_done
  LDA 10
  DCD

  LDR row
  INC
  STA row

  LDR row
  LDA 5
  GTH
  JCN outer_done
  JMP outer

>outer_done
BRK